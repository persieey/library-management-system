# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าได้ตามต้องการ
# ถ้าไม่สร้าง .env เลย docker compose จะใช้ค่าเริ่มต้นด้านล่างนี้อยู่แล้ว
# .env ห้าม commit ขึ้น git เพราะมีรหัสผ่าน

# ---- Postgres (ใช้โดย docker compose) ----
POSTGRES_USER=lms
POSTGRES_PASSWORD=lmsdev
POSTGRES_DB=library
POSTGRES_PORT=5432

# ---- pgAdmin ----
# ต้องเป็นรูปแบบอีเมลที่ถูกต้องจริง โดเมนอย่าง .local จะทำให้ pgAdmin ไม่ยอมสตาร์ท
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin1234
PGADMIN_PORT=5050

# ---- backend ----
# ไม่ตั้ง LMS_DB_DRIVER เลย = ใช้ SQLite ไฟล์เดียว ไม่ต้องมี Docker
# ตั้งเป็น postgres เมื่อเปิด docker compose ไว้แล้ว
#
#   LMS_DB_DRIVER=postgres
#   LMS_DB_DSN=postgres://lms:lmsdev@localhost:5432/library?sslmode=disable
#
# ค่าอื่นที่ปรับได้
#   LMS_DB_PATH=library.db                    ชื่อไฟล์ตอนใช้ SQLite
#   LMS_ADDR=:8080                            พอร์ตของ backend
#   LMS_CORS_ORIGIN=http://localhost:3000     origin ของหน้าเว็บ
#   LMS_SEED_PASSWORD=devpass                 รหัสผ่านบัญชีทดสอบตอนสร้างครั้งแรก

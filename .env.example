# ไฟล์นี้เป็นค่าของ docker compose เท่านั้น (Postgres + pgAdmin)
# ส่วนค่าของ backend อยู่คนละไฟล์ ดูที่ backend/.env.example
#
# คัดลอกเป็น .env แล้วแก้ได้ตามต้องการ ถ้าไม่สร้างเลย compose จะใช้ค่าด้านล่างนี้อยู่แล้ว
# .env ห้าม commit ขึ้น git เพราะมีรหัสผ่าน

# ---- Postgres ----
# ค่าสามตัวนี้ต้องตรงกับ DB_USER / DB_PASSWORD / DB_NAME ใน backend/.env
# ไม่งั้น backend จะต่อฐานข้อมูลไม่ติด
POSTGRES_USER=lms
POSTGRES_PASSWORD=lmsdev
POSTGRES_DB=t09db
POSTGRES_PORT=5432

# ---- pgAdmin ----
# ต้องเป็นรูปแบบอีเมลที่ถูกต้องจริง โดเมนอย่าง .local จะทำให้ pgAdmin ไม่ยอมสตาร์ท
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin1234
PGADMIN_PORT=5050

# คัดลอกไฟล์นี้เป็น backend/.env แล้วเติมค่าที่ว่างไว้
# ค่าที่ใส่มาให้แล้วตรงกับ docker-compose.yml ที่ root ถ้าไม่ได้เปลี่ยนพอร์ตก็ใช้ได้เลย
# .env ห้าม commit ขึ้น git เพราะมีรหัสผ่าน

# ---- ฐานข้อมูล ----
# ต้องเปิด docker compose up -d ที่ root ก่อน ไม่งั้น backend จะต่อไม่ติด
DB_HOST=localhost
DB_PORT=5432
DB_USER=lms
DB_PASSWORD=lmsdev
DB_NAME=t09db

# ---- JWT ----
# ตั้งเป็นสตริงสุ่มยาวๆ ห้ามใช้ค่าเดียวกับเพื่อน และห้ามใช้ค่านี้ตอนขึ้นจริง
# สร้างได้ด้วย: openssl rand -hex 32
JWT_SECRET=
# อายุ token ไม่ตั้งก็ได้ ค่าเริ่มต้นคือ 24h
JWT_EXPIRES_IN=24h

# ---- เซิร์ฟเวอร์ ----
SERVER_PORT=8080

# ---- บัญชีที่สร้างให้อัตโนมัติตอนรันครั้งแรก ----
# รหัสผ่านนี้ใช้กับบัญชีทดสอบทุกใบ (admin, librarian@lib.ac.th, staff@lib.ac.th)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
